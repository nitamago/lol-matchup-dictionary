---
import fs from "fs";
import path from "path";

export async function getStaticPaths() {
  const filePath = `./src/data/name_to_ja_map.json`;
  const to_ja_map = JSON.parse(fs.readFileSync(filePath, "utf-8"));
  const to_en_map = Object.fromEntries(Object.entries(to_ja_map).map(([k, v]) => [v, k]));

  const roles = ["top", "mid", "jg", "bot", "sup"];
  const matchupsKeysByRole: Record<string, string[]> = {};
  const paths = [];

  for (const role of roles) {
    let data;
    let championKeys: string[] = [];
    try {
      const filePath = `./src/data/${role}_matchups.json`;
      data = JSON.parse(fs.readFileSync(filePath, "utf-8"));
      // console.log(data);
      championKeys = Object.keys(data);

    } catch (err) {
      console.warn(`${role}_matchups.json が読み込めません:`, err);
    }
    let runeBuildData: Record<string, any> = {};
    try {
      const runeBuildFilePath = `./src/data/${role}_rune_build.json`;
      runeBuildData = JSON.parse(fs.readFileSync(runeBuildFilePath, "utf-8"));

      // 相手チャンプ⇔自チャンプのURLも登録する
      const completed: Record<string, any> = {};
      for (const champ of Object.keys(runeBuildData)) {
        if (!(champ in completed)) {
          completed[champ] = {};
        }
        for (const vsChamp of Object.keys(runeBuildData[champ])) {
          completed[champ][vsChamp] = runeBuildData[champ][vsChamp];
          if (!(vsChamp in completed)) {
            completed[vsChamp] = {};
          }
          const url = runeBuildData[champ][vsChamp];
          const champ1 = url.split("/lol/")[1].split("/vs/")[0];
          const champ2 = url.split("/lol/")[1].split("/vs/")[1].split("/")[0];
          let lane = "";
          switch (role) {
            case "top":
              lane = "top";
              break;
            case "mid":
              lane = "middle";
              break;
            case "jg":
              lane = "jungle";
              break;
            case "bot":
              lane = "bottom";
              break;
            case "sup":
              lane = "support";
              break;
            default:
              console.log(`Sorry, we are out of ${role}.`);
          }
          const inverseUrl = "https://lolalytics.com/ja/lol/"+champ2+"/vs/"+champ1+"/build/?vslane="+lane+"&patch=14";
          completed[vsChamp][champ] = inverseUrl;
        }
      }
      runeBuildData = completed;

    } catch (err) {
      runeBuildData = {};
      console.warn(`${role}_rune_build.json が読み込めません:`, err);
    }

      for (const champkey of championKeys) { 
        data[champkey] = data[champkey] || {};
        // 有利な相手
        const advantage = data[champkey]["loses"] || []
        if (advantage) {
          for (const vs of advantage) {
              let runeBuildUrl = "https://lolalytics.com/ja/";
              if ((vs.name in runeBuildData)&&(champkey in runeBuildData[vs.name])) {
                runeBuildUrl = runeBuildData[vs.name][champkey];
              }
              // paths.push({ params: { role, champ: to_en_map[champkey], vsChamp: to_en_map[vs.name] } });
              paths.push({ params: { role, champ: champkey, vsChamp: vs.name},
                           props: { runeBuildUrl } });
          }
        }
        // 不利な相手
        const disadvantage = data[champkey]["beats"] || []
        if (disadvantage) {
          for (const vs of disadvantage) {
              let runeBuildUrl = "https://lolalytics.com/ja/";
              if ((vs.name in runeBuildData)&&(champkey in runeBuildData[vs.name])) {
                runeBuildUrl = runeBuildData[vs.name][champkey];
              }
              // console.log(vs.name, champkey);
              // console.log(runeBuildUrl);
              // paths.push({ params: { role, champ: to_en_map[champkey], vsChamp: to_en_map[vs.name] } });
              paths.push({ params: { role, champ: champkey, vsChamp: vs.name},
                          props: { runeBuildUrl } });
          }
        }
        // 互角な相手
        const even = data[champkey]["even_list"] || []
        if (even) {
          for (const vs of even) {
              let runeBuildUrl = "https://lolalytics.com/ja/";
              if ((vs.name in runeBuildData)&&(champkey in runeBuildData[vs.name])) {
                runeBuildUrl = runeBuildData[vs.name][champkey];
              }
              // console.log(vs.name, champkey);
              // console.log(runeBuildUrl);
              // paths.push({ params: { role, champ: to_en_map[champkey], vsChamp: to_en_map[vs.name] } });
              paths.push({ params: { role, champ: champkey, vsChamp: vs.name},
                          props: { runeBuildUrl } });
          }
        }
      }
  }

  return paths;
}


const { role, champ, vsChamp } = Astro.params;
const { runeBuildUrl } = Astro.props;

// URLデコード
const champDecode = decodeURIComponent(champ);
const vsChampDecode = decodeURIComponent(vsChamp);

// // HTML ファイルを読み込む
let content = "<p>解説が見つかりません</p>";
try {
  // console.log(`./public/matchups/explanation_${role}_${champDecode}_vs_${vsChampDecode}.html`)
  const filePath = path.resolve(`./public/matchups/explanation_${role}_${champDecode}_vs_${vsChampDecode}.html`);
  content = fs.readFileSync(filePath, "utf-8").replace(/^\uFEFF/, "");
} catch (err) {
  console.warn("HTMLが見つかりません:", err);
}

const ga4TrackingCode = `
<script async src="https://www.googletagmanager.com/gtag/js?id=G-BSBMFV37ZG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'GT-KFNRBGDS');
  gtag("event", "detail");
</script>
`;
---
<html>
  <head>
    <meta charset="UTF-8" />
		<!-- Google tag (gtag.js) -->
    <Fragment set:html={ga4TrackingCode} />
		</script>
  </head>
  <body>
    <div class="flex flex-wrap">
      {content === "<p>解説が見つかりません</p>" ? <h2>{champDecode} vs {vsChampDecode}</h2> : ""}
      <div set:html={content}></div>
      <div>
        <h2>ルーン&ビルド</h2>
        {runeBuildUrl ? (
          <p>こちらの<a href={runeBuildUrl} target="_blank" rel="noopener noreferrer">リンク</a>を参考にしてください。</p>
        ) : (
          <p>リンクなし</p>
        )}
      </div>
      <div class="ai-disclaimer">
        ※本記事の内容は<strong>AI（人工知能）</strong>によって自動生成されたものであり、<br>
        人間による監修を経ていない部分があります。情報の正確性や最新性を保証するものではありません。
      </div>
      <style>
        .ai-disclaimer {
          padding: 10px 14px;
          margin: 20px 0;
        }
      </style>
    </div>
  </body>
</html>
