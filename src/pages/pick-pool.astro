---
import champions from "../data/champions.json";

// champions.json はオブジェクトなので配列化
let champList = Object.entries(champions).map(([id, data]) => ({
  id,
  name: data.name,
  icon: data.icon
}));

// 初期状態では名前順（昇順）にソート
champList = champList.sort((a, b) => a.name.localeCompare(b.name, "ja"));
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-BSBMFV37ZG"></script>
		<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', 'G-BSBMFV37ZG');
		</script>
    <title>ピックプール設定</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #f9fafb;
        margin: 0;
        padding: 20px;
      }

      h1 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
      }

      p {
        margin-bottom: 1rem;
        color: #374151;
      }

      .controls {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 1rem;
      }

      .sort-btn {
        background: #e5e7eb;
        color: #111827;
        border: none;
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        transition: 0.2s;
      }

      .sort-btn:hover {
        background: #d1d5db;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
      }

      .champ {
        border: 2px solid transparent;
        border-radius: 12px;
        background: white;
        text-align: center;
        padding: 6px;
        cursor: pointer;
        transition: 0.15s;
      }

      .champ img {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        object-fit: cover;
      }

      .champ.selected {
        border-color: #3b82f6;
        background: #dbeafe;
        transform: scale(1.05);
      }

      .save-btn {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 16px;
        background: #2563eb;
        color: white;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-size: 1rem;
      }

      .save-btn:hover {
        background: #1d4ed8;
      }
    </style>
  </head>

  <body>
    <main>
      <h1>ピックプール設定</h1>
      <p>
        あなたの得意チャンピオンを選択してピックプールを作成しましょう。<br />
        選択内容はブラウザに保存され、後でフィルタリングに使えます。
      </p>

      <div class="controls">
        <button id="sortBtn" class="sort-btn">名前順ソート</button>
      </div>

      <div id="champGrid" class="grid">
        {champList.map((c) => (
          <div class="champ" data-id={c.id} data-name={c.name}>
            <img src={c.icon} alt={c.name} />
            <div>{c.name}</div>
          </div>
        ))}
      </div>

      <button id="saveBtn" class="save-btn">保存</button>
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const champs = document.querySelectorAll(".champ");
        const saveBtn = document.getElementById("saveBtn");
        const sortBtn = document.getElementById("sortBtn");
        const grid = document.getElementById("champGrid");

        // 保存済みデータをロード
        const saved = JSON.parse(localStorage.getItem("pickPool") || "[]");
        saved.forEach(id => {
          const el = document.querySelector(`.champ[data-id="${id}"]`);
          if (el) el.classList.add("selected");
        });

        // チャンピオンクリックで選択切り替え
        champs.forEach(el => {
          el.addEventListener("click", () => {
            el.classList.toggle("selected");
          });
        });

        // 保存処理
        saveBtn.addEventListener("click", () => {
          const selected = Array.from(document.querySelectorAll(".champ.selected"))
            .map(el => el.dataset.id);
          localStorage.setItem("pickPool", JSON.stringify(selected));
          alert("ピックプールを保存しました！");
        });

        // ソート処理
        sortBtn.addEventListener("click", () => {
          const items = Array.from(grid.children);
          const sorted = items.sort((a, b) => 
            a.dataset.name.localeCompare(b.dataset.name, "ja")
          );
          grid.innerHTML = "";
          sorted.forEach(el => grid.appendChild(el));
        });
      });
    </script>
  </body>
</html>
