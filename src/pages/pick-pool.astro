---
import "../styles/global.css";
import champions from "../data/champions.json";

// champions.json はオブジェクトなので配列化
let champList = Object.entries(champions).map(([id, data]) => ({
  id,
  name: data.name,
  icon: data.icon
}));

// 初期状態では名前順（昇順）にソート
champList = champList.sort((a, b) => a.name.localeCompare(b.name, "ja"));
---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>ピックプール設定</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BSBMFV37ZG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BSBMFV37ZG');
    </script>
    <style>
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
        gap: 10px;
      }

      .champ {
        border: 2px solid transparent;
        border-radius: 12px;
        background: white;
        text-align: center;
        padding: 6px;
        cursor: pointer;
        transition: 0.15s;
      }

      @media (width >= 64rem) {
        .champ img {
          width: 64px;
          height: 64px;
          border-radius: 8px;
          object-fit: cover;
        }
      }

      .champ img {
        width: 128px;
        height: 128px;
        border-radius: 8px;
        object-fit: cover;
      }

      .champ.selected {
        border-color: #3b82f6;
        background: #dbeafe;
        transform: scale(1.05);
      }
    </style>
  </head>

  <body class="bg-gray-50 font-sans p-5">
    <main class="max-w-5xl mx-auto">
      <h1 class="text-2xl font-bold mb-2 text-4xl lg:text-base">ピックプール設定</h1>
      <p class="mb-4 text-gray-700 text-4xl lg:text-base">
        あなたの得意チャンピオンを選択してピックプールを作成しましょう。<br />
        選択内容はブラウザに保存され、後でフィルタリングに使えます。
      </p>

      <div class="flex gap-3 items-center mb-4">
        <button id="sortBtn" class="bg-gray-200 text-gray-900 rounded-md px-3 py-1 hover:bg-gray-300 transition text-lg">
          名前順ソート
        </button>
      </div>

      <div id="champGrid" class="grid">
        {champList.map((c) => (
          <div class="champ" data-id={c.id} data-name={c.name}>
            <img src={c.icon} alt={c.name} />
            <div>{c.name}</div>
          </div>
        ))}
      </div>

      <button id="saveBtn" class="mt-5 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition text-4xl lg:text-base">
        保存
      </button>
    </main>

    <script type="module">
      
      document.addEventListener("DOMContentLoaded", () => {
        const champs = document.querySelectorAll(".champ");
        const saveBtn = document.getElementById("saveBtn");
        const sortBtn = document.getElementById("sortBtn");

        // 保存済みデータをロード
        const saved = JSON.parse(localStorage.getItem("pickPool") || "[]");
        saved.forEach(id => {
          const el = document.querySelector(`.champ[data-id="${id}"]`);
          if (el) el.classList.add("selected");
        });

        // チャンピオンクリックで選択切り替え
        champs.forEach(el => {
          el.addEventListener("click", () => {
            el.classList.toggle("selected");
          });
        });

        // 保存処理
        saveBtn.addEventListener("click", () => {
          const selected = Array.from(document.querySelectorAll(".champ.selected"))
            .map(el => el.dataset.id);
          localStorage.setItem("pickPool", JSON.stringify(selected));
          alert("ピックプールを保存しました！");
        });

        // ソート処理
        sortBtn.addEventListener("click", () => {
          const items = Array.from(grid.children);
          const sorted = items.sort((a, b) => 
            a.dataset.name.localeCompare(b.dataset.name, "ja")
          );
          grid.innerHTML = "";
          sorted.forEach(el => grid.appendChild(el));
        });
      });
    </script>
  </body>
</html>
