---
import "../../../styles/global.css";
import fs from "fs";
import path from "path";

// JSON のトップレベルはオブジェクトなので keys で role を取得
export async function getStaticPaths() {
  const filePath = `./src/data/name_to_ja_map.json`;
  const to_ja_map = JSON.parse(fs.readFileSync(filePath, "utf-8"));
  const to_en_map = Object.fromEntries(Object.entries(to_ja_map).map(([k, v]) => [v, k]));
  
  const imgFilePath = `./src/data/champions.json`;
  const to_img_map = JSON.parse(fs.readFileSync(imgFilePath, "utf-8"));

  const roles: string[] = ["top", "mid", "jg", "bot", "sup"];
  const matchupsByRole: Record<string, any> = {};
  const matchupsKeysByRole: Record<string, any> = {};
  const dataByRole: Record<string, any> = {};

  const runeBuildData: Record<string, any> = {};

  for (const role of roles) {
    try {
      const filePath = `./src/data/${role}_matchups.json`;
      const rawData: Record<string, any> = JSON.parse(fs.readFileSync(filePath, "utf-8"));
      const data: Record<string, any> = {};

      // 後出しデータから先出データを生成
      for (const oppenent of Object.keys(rawData)) {
        if (rawData[oppenent]["game_count"] < 14000) {
          continue;
        }
        for (const beat of rawData[oppenent]["beats"]) {
          if (!(beat.name in data)) {
            data[beat.name] = {name: beat.name, game_count:0, loses:[], beats:[], even_list:[]};
          }
          data[beat.name]['loses'].push({
            name: oppenent,
            delta2: beat.delta2
          });
        }
        for (const lose of rawData[oppenent]["loses"]) {
          if (!(lose.name in data)) {
            data[lose.name] = {name: lose.name, game_count:0, loses:[], beats:[], even_list:[]};
          }
          data[lose.name]['beats'].push({
            name: oppenent,
            delta2: lose.delta2
          });
        }
        for (const even of rawData[oppenent]["even_list"]) {
          if (!(even.name in data)) {
            data[even.name] = {name: even.name, game_count:0, loses:[], beats:[], even_list:[]};
          }
          data[even.name]['even_list'].push({
            name: oppenent,
            delta2: even.delta2
          });
        }
        if (!(oppenent in data)) {
          data[oppenent] = {name: oppenent, game_count:0, loses:[], beats:[], even_list:[]};
        }
        data[oppenent]['game_count'] = rawData[oppenent]['game_count'];
      }
      for (const champ of Object.keys(data)) {
        if ((data[champ]['loses'].length == 0)||(data[champ]['beats'].length == 0)||(data[champ]['even_list'].length == 0)) {
          delete data[champ];
        }
      }

      dataByRole[role] = data;
      const championKeys = Object.keys(data)
      matchupsKeysByRole[role] = championKeys;
      const advantage = championKeys.map(c => data[c]["loses"]).flat();
      const disadvantage = championKeys.map(c => data[c]["beats"]).flat();
      const allList = advantage.concat(disadvantage);
      matchupsByRole[role] = allList || []; 
    } catch (err) {
      matchupsByRole[role] = [];
      dataByRole[role] = [];
      console.warn(`${role}_matchups.json が読み込めません:`, err);
    }
    try {
      const runeBuildFilePath = `./src/data/${role}_rune_build.json`;
      runeBuildData[role] = JSON.parse(fs.readFileSync(runeBuildFilePath, "utf-8"));
    } catch (err) {
      runeBuildData[role] = {};
      console.warn(`${role}_rune_build.json が読み込めません:`, err);
    }
  }

  return roles.map((role) => ({
    params: { role },
    props: { role, champions: matchupsKeysByRole[role], data: dataByRole[role], enMap: to_en_map, imgMap: to_img_map, runeBuildMap: runeBuildData[role]} // role に対応する配列を渡す
  }));
}

const { role, champions, data, enMap, imgMap, runeBuildMap } = Astro.props;

---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-BSBMFV37ZG"></script>
		<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', 'G-BSBMFV37ZG');
		</script>
    <!-- <title>{role} ロールのチャンピオン一覧</title> -->
    <title>自分チャンピオン一覧</title>
    <script type="module" defer>
      window.addEventListener("load", () => {
        const detailDiv = document.getElementById("champion-detail");
        const roleDataDiv = document.getElementById("role-data");
        const roleData = JSON.parse(roleDataDiv.textContent);
        const enMapDiv = document.getElementById("role-en-map");
        const enMap = JSON.parse(enMapDiv.textContent);
        const role = document.getElementById("role").textContent.trim();
        const imgMapDiv = document.getElementById("img-map");
        const imgMap = JSON.parse(imgMapDiv.textContent);
        const runeBuildMapDiv = document.getElementById("rune-build-map");
        const runeBuildMap = JSON.parse(runeBuildMapDiv.textContent);

        const links = document.querySelectorAll("#champion-list a");

        links.forEach(link => {
          link.addEventListener("click", e => {
            e.preventDefault();
            const champName = link.dataset.champ;
            const champData = roleData[champName];

            if (!champData) {
              detailDiv.innerHTML = "<p>データが見つかりません</p>";
              return;
            }

            // 詳細リスト生成（右側）
            let html = `<h2>${champData.name}</h2>`;
            const formatter = new Intl.NumberFormat("ja-JP");
            html += `<h3>ゲーム数: ${formatter.format(champData.game_count)}</h3>`;
            html += `${
              champData.game_count < 14000
                ? '<p class="text-red-700">※データ数が少ないため、参考程度にしてください</p>'
                : ""
            }`;

            html += `<p class="block lg:hidden mb-4 text-gray-700">
              ※下のチャンピオン名をクリックすると、詳細な解説ページが表示されます
            </p>`;
            html += `<p class="hidden lg:block mb-4 text-gray-700">
              ※右のチャンピオン名をクリックすると、詳細な解説ページが表示されます
            </p>`;

            // 共通のテーブル生成関数
            function buildTable(title, data, color) {
              let table = `<div class="mb-6">
                <h3 class="font-bold mb-2">${title}</h3>
                <table class="w-full border border-collapse bg-gray-50">
                  <thead>
                    <tr class="${color}">
                      <th align="left" class="border">相手チャンピオン</th>
                      <th align="left" class="border">勝率</th>
                    </tr>
                  </thead>
                  <tbody>`;
              data.forEach((d) => {
                const runeBuildUrl = runeBuildMap?.[d.name]?.[champData.name];

                table += `<tr>
                  <td class="flex flex-row border p-[3px]">
                    <img
                      src=${imgMap[d.name]['icon']}
                      alt=${d.name}
                      class="w-[32px] h-[32px] block object-contain hover:scale-110 transition"
                    />
                    <a href="/lol-matchup-dictionary/${role}/${d.name}/${champData.name}" 
                      class="block text-blue-600 hover:underline">${d.name}
                    </a>
                  </td>
                  <td class="border text-xs ">${(50 - parseFloat(d.delta2)).toFixed(1)}%</td>
                </tr>`;
              });
              table += `</tbody></table></div>`;
              return table;
            }

            // 3つのテーブルを追加
            html += buildTable("有利なチャンピオン", champData.beats, "bg-green-200");
            html += buildTable("互角なチャンピオン", champData.even_list, "bg-yellow-200");
            html += buildTable("不利なチャンピオン", champData.loses, "bg-red-200");

            detailDiv.innerHTML = html;


          });
        });
      });
    </script>
  </head>
  <body class="flex max-lg:flex-col max-lg:text-5xl gap-4 p-4 bg-blue-100">
    <!-- 左側：チャンピオン一覧 -->
    <div class="w-full h-[30vh] lg:w-1/2 lg:h-[100vh]">
      <!-- <h1>{role} ロールのチャンピオン</h1> -->
      <h1>自分チャンピオン一覧</h1>
      <ul id="champion-list" class="flex flex-wrap justify-center items-center gap-x-[14px] gap-y-[24px] h-[90%] overflow-scroll bg-gray-100 p-4 text-base border rounded">
        {champions.slice() // 元配列を壊さないようコピー
                  .sort((a, b) => a.localeCompare(b, "ja")) // 日本語に対応した昇順ソート
                  .map(c => {
                    if (!(c in imgMap)) {
                      return (
                        <li>
                          <a href="#" data-champ={c} class="text-blue-600 hover:underline">
                            {c}
                          </a>
                        </li> 
                      );
                    } else {
                      return (
                        <li>
                          <a href="#" data-champ={c} class="text-blue-600 w-[46px] h-[46px] block hover:underline">
                            <img
                              src={imgMap[c]['icon']}
                              alt={c}
                              class="object-contain hover:scale-110 transition"
                            />
                            {c}
                          </a>
                        </li>
                    );}
        })}
      </ul>
    </div>

    <!-- 右側：詳細表示 -->
    <div id="champion-detail" class="lg:w-1/2 sticky top-0">
      <p class="block lg:hidden font-semibold text-blue-700">
        上の一覧から対面チャンピオン名をクリックしてください
      </p>
      <p class="hidden lg:block font-semibold text-blue-700">
        左の一覧から対面チャンピオン名をクリックしてください
      </p>
    </div>

    <!-- 埋め込みデータ -->
    <div id="role" class="hidden">
      {role}
    </div>
    <!-- 埋め込みデータ -->
    <div id="role-data" class="hidden">
      {JSON.stringify(data)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="role-en-map" class="hidden">
      {JSON.stringify(enMap)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="img-map" class="hidden">
      {JSON.stringify(imgMap)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="rune-build-map" class="hidden">
      {JSON.stringify(runeBuildMap)}
    </div>
  </body>
</html>