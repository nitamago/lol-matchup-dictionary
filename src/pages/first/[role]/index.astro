---
import { date } from "astro:schema";
import "../../../styles/global.css";
import fs from "fs";
import path from "path";
import CollapsibleSection from "../../../components/CollapsibleSection.astro";

// JSON のトップレベルはオブジェクトなので keys で role を取得
export async function getStaticPaths() {
  const filePath = `./src/data/name_to_ja_map.json`;
  const to_ja_map = JSON.parse(fs.readFileSync(filePath, "utf-8"));
  const to_en_map = Object.fromEntries(Object.entries(to_ja_map).map(([k, v]) => [v, k]));
  
  const imgFilePath = `./src/data/champions.json`;
  const to_img_map = JSON.parse(fs.readFileSync(imgFilePath, "utf-8"));

  const roles: string[] = ["top", "mid", "jg", "bot", "sup"];
  const matchupsByRole: Record<string, any> = {};
  const matchupsKeysByRole: Record<string, any> = {};
  const dataByRole: Record<string, any> = {};

  const runeBuildData: Record<string, any> = {};

  const synergyByRole: Record<string, any> = {};
  const synergyKeysByRole: Record<string, any> = {};

  const rawDataByRole: Record<string, any> = {};

  for (const role of roles) {
    try {
      const filePath = `./src/data/${role}_matchups.json`;
      const data: Record<string, any> = JSON.parse(fs.readFileSync(filePath, "utf-8"));

      dataByRole[role] = data;
      const championKeys = Object.keys(data)
      matchupsKeysByRole[role] = championKeys;
      const advantage = championKeys.map(c => data[c]["loses"]).flat();
      const disadvantage = championKeys.map(c => data[c]["beats"]).flat();
      const allList = advantage.concat(disadvantage);
      matchupsByRole[role] = allList || []; 
    } catch (err) {
      matchupsByRole[role] = [];
      dataByRole[role] = [];
      console.warn(`${role}_matchu_synergyps.json が読み込めません:`, err);
    }
    try {
      const runeBuildFilePath = `./src/data/${role}_rune_build.json`;
      runeBuildData[role] = JSON.parse(fs.readFileSync(runeBuildFilePath, "utf-8"));
    } catch (err) {
      runeBuildData[role] = {};
      console.warn(`${role}_rune_build.json が読み込めません:`, err);
    }

    try {
      const synergeyFilePath = `./src/data/${role}_synergy.json`;
      const synergeyDataRaw: Record<string, any> = JSON.parse(fs.readFileSync(synergeyFilePath, "utf-8"));
      for (const champ of Object.keys(synergeyDataRaw)) {
        if (synergeyDataRaw[champ]["game_count"] < 14000) {
          delete synergeyDataRaw[champ];
        }
      }
      const synergeyData: Record<string, any> = {};
      const pos_key_set: Record<string, any> = {};
      for (const champ of Object.keys(synergeyDataRaw)) {
        for (const pos of Object.keys(synergeyDataRaw[champ])) {
          if (!(pos in synergeyData)) {
            synergeyData[pos] = {};
          }
          for (const mate of Object.keys(synergeyDataRaw[champ][pos])) {
            if (!(champ in synergeyData[pos])) {
              synergeyData[pos][champ] = {};
            }
            synergeyData[pos][champ][mate] = synergeyDataRaw[champ][pos][mate];
          }
        }
      }
      synergyByRole[role] = synergeyData;
      synergyKeysByRole[role] = {'top':new Set(), 'mid':new Set(), 'jg':new Set(), 'bot':new Set(), 'sup':new Set()};
      for (const pos of Object.keys(synergeyData)) {
        for (const champ of Object.keys(synergeyData[pos])) {
          const list: string[] = Object.keys(synergeyData[pos][champ]);
          synergyKeysByRole[role][pos] = new Set([...synergyKeysByRole[role][pos], ...new Set(list)]); ;
        }
        synergyKeysByRole[role][pos] = Array.from(synergyKeysByRole[role][pos])
      }
    } catch (err) {
      synergyByRole[role] = {};
      synergyKeysByRole[role] = {'top':[], 'mid':[], 'jg':[], 'bot':[], 'sup':[]};
      console.warn(`${role}_synergy.json が読み込めません:`, err);
    }

    try {
      const rawDataFilePath = `./src/data/${role}_raw_data.json`;
      rawDataByRole[role] = JSON.parse(fs.readFileSync(rawDataFilePath, "utf-8"));
    } catch (err) {
      rawDataByRole[role] = {};
      console.warn(`${role}_raw_data.json が読み込めません:`, err);
    }
  }

  return roles.map((role) => ({
    params: { role },
    props: { role, champions: matchupsKeysByRole[role], data: dataByRole[role], 
             enMap: to_en_map, imgMap: to_img_map, runeBuildMap: runeBuildData[role],
             synergeyMaps: synergyByRole, synergyChampions: synergyKeysByRole[role], rawData: rawDataByRole[role] } // role に対応する配列を渡す
  }));
}

const { role, champions, data, enMap, imgMap, runeBuildMap, synergeyMaps, synergyChampions, rawData } = Astro.props;

---
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-BSBMFV37ZG"></script>
		<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', 'G-BSBMFV37ZG');
		</script>

    <style>
      th {
        cursor: pointer;
        user-select: none;
      }
      th.sort-asc::after {
        content: " ▲";
      }
      th.sort-desc::after {
        content: " ▼";
      }
    </style>

    <!-- <title>{role} ロールのチャンピオン一覧</title> -->
    <title>自分チャンピオン一覧</title>
    <script type="module" defer>
      const detailDiv = document.getElementById("champion-detail");
      const roleDataDiv = document.getElementById("role-data");
      const roleData = JSON.parse(roleDataDiv.textContent);
      const roleDataKeyDiv = document.getElementById("role-data-key");
      const roleDataKey = JSON.parse(roleDataKeyDiv.textContent);
      const enMapDiv = document.getElementById("role-en-map");
      const enMap = JSON.parse(enMapDiv.textContent);
      const role = document.getElementById("role").textContent.trim();
      const imgMapDiv = document.getElementById("img-map");
      const imgMap = JSON.parse(imgMapDiv.textContent);
      const runeBuildMapDiv = document.getElementById("rune-build-map");
      const runeBuildMap = JSON.parse(runeBuildMapDiv.textContent);
      const synergyChampionsDiv = document.getElementById("synergy-champions");
      const synergyChampions = JSON.parse(synergyChampionsDiv.textContent);
      const rawDataDiv = document.getElementById("raw-data");
      const rawData = JSON.parse(rawDataDiv.textContent);

      window.addEventListener("load", () => {
        const links = document.querySelectorAll("#champion-list a");

        links.forEach(link => {
          link.addEventListener("click", e => {
            e.preventDefault();
            console.log('click fired');
            console.log(link.dataset.champ);
            const champName = link.dataset.champ;
            const champData = roleData[champName];

            if (!champData) {
              detailDiv.innerHTML = "<p>データが見つかりません</p>";
              return;
            }

            // 詳細リスト生成（右側）
            let html = `<h2>${champData.name}</h2>`;
            const formatter = new Intl.NumberFormat("ja-JP");
            html += `<h3>ゲーム数: ${formatter.format(champData.game_count)}</h3>`;
            html += `${
              champData.game_count < 14000
                ? '<p class="text-red-700">※データ数が少ないため、参考程度にしてください</p>'
                : ""
            }`;

            html += `<p class="block lg:hidden mb-4 text-gray-700">
              ※下のチャンピオン名をクリックすると、詳細な解説ページが表示されます
            </p>`;
            html += `<p class="hidden lg:block mb-4 text-gray-700">
              ※右のチャンピオン名をクリックすると、詳細な解説ページが表示されます
            </p>`;

            // 共通のテーブル生成関数
            function buildTable(title, data, color) {
              let table = `<div class="mb-6">
                <h3 class="font-bold mb-2">${title}</h3>
                <table class="w-full border border-collapse bg-gray-50">
                  <thead>
                    <tr class="${color}">
                      <th align="left" class="border text-4xl lg:text-lg">相手チャンピオン</th>
                      <th align="left" class="border text-4xl lg:text-lg">勝率</th>
                    </tr>
                  </thead>
                  <tbody>`;
              data.forEach((d) => {
                const runeBuildUrl = runeBuildMap?.[d.name]?.[champData.name];

                let win_rate = '';
                if (d.delta2.includes('*')){
                  win_rate = (50 + parseFloat(d.delta2.replace('*', ''))).toFixed(1)+'%*';
                } else {
                  win_rate = (50 + parseFloat(d.delta2)).toFixed(1)+'%';
                }
                 
                table += `<tr>
                  <td class="flex flex-row border p-[3px]">
                    <img
                      src=${imgMap[d.name]['icon']}
                      alt=${d.name}
                      class="w-[64px] h-[64px] lg:w-[32px] lg:h-[32px] block object-contain hover:scale-110 transition"
                    />
                    <a href="/${role}/${d.name}/${champData.name}" target="_blank" 
                      class="block text-blue-600 hover:underline">${d.name}
                    </a>
                  </td>
                  <td class="border text-4xl lg:text-base">${win_rate}
                  </td>
                </tr>`;
              });
              table += `</tbody></table></div>`;
              return table;
            }

            // 3つのテーブルを追加
            html += buildTable("有利なチャンピオン", champData.beats, "bg-green-200");
            html += buildTable("互角なチャンピオン", champData.even_list, "bg-yellow-200");
            html += buildTable("不利なチャンピオン", champData.loses, "bg-red-200");

            detailDiv.innerHTML = html;


          });
        });
      });

      document.addEventListener("DOMContentLoaded", () => {
        const itemsTop = document.querySelectorAll(".champ-item-top");
        const itemsJg = document.querySelectorAll(".champ-item-jg");
        const itemsMid = document.querySelectorAll(".champ-item-mid");
        const itemsBot = document.querySelectorAll(".champ-item-bot");
        const itemsSup = document.querySelectorAll(".champ-item-sup");
        let selectedTop = null;
        let selectedJg = null;
        let selectedMid = null;
        let selectedBot = null;
        let selectedSup = null;

        function scoreUpdate(){
          const synergyMapsDiv = document.getElementById("synergy-map");
          const synergyMaps = JSON.parse(synergyMapsDiv.textContent);
          const scoreData = {};
          let synergyTopList = [];
          let synergyMidList = [];
          let synergyJgList = [];
          let synergyBotList = [];
          let synergySupList = [];

          function sliceSynergy(map){
            let result = [];
            const sorted = Object.entries(map).sort((a, b) => b[1] - a[1]);
            const top5 = sorted.slice(0, 5);
            const bottom5 = sorted.slice(-5);
            result = result.concat(top5).concat(bottom5).map((a)=>a[0]);
            return result;
          }

          for (const champ of roleDataKey){
            let total = 0;
            if(selectedTop){
              const mate = selectedTop.dataset.value;
              if (synergyMaps['top'][role][mate][champ]) {
                total += parseFloat(synergyMaps['top'][role][mate][champ]);
              }     
              const map = synergyMaps['top'][role][mate];
              synergyTopList = sliceSynergy(map)
            }
            if(selectedJg){
              const mate = selectedJg.dataset.value;
              if (synergyMaps['jg'][role][mate][champ]) {
                total += parseFloat(synergyMaps['jg'][role][mate][champ]);
              }
              const map = synergyMaps['jg'][role][mate];
              synergyJgList = sliceSynergy(map)
            }
            if(selectedMid){
              const mate = selectedMid.dataset.value;
              if (synergyMaps['mid'][role][mate][champ]) {
                total += parseFloat(synergyMaps['mid'][role][mate][champ]);
              }
              const map = synergyMaps['mid'][role][mate];
              synergyMidList = sliceSynergy(map)
            }
            if(selectedBot){
              const mate = selectedBot.dataset.value;
              if (synergyMaps['bot'][role][mate][champ]) {
                total += parseFloat(synergyMaps['bot'][role][mate][champ]);
              }
              const map = synergyMaps['bot'][role][mate];
              synergyBotList = sliceSynergy(map)
            }
            if(selectedSup){
              const mate = selectedSup.dataset.value;
              if (synergyMaps['sup'][role][mate][champ]) {
                total += parseFloat(synergyMaps['sup'][role][mate][champ]);
              }
              const map = synergyMaps['sup'][role][mate];
              synergySupList = sliceSynergy(map)
            }
            scoreData[champ] = total;
          }
          
          const table = document.getElementById("champion-table");

          // 各行を走査（0行目はヘッダーなので除外）
          for (let i = 1; i < table.rows.length; i++) {
            const nameCell = table.rows[i].cells[0]; // 名前セル
            const champName = nameCell.textContent.trim();
              
            const scoreCell = table.rows[i].cells[3]; // 名前セル
            if (champName in scoreData) {
              const score = scoreData[champName].toFixed(1);
              const imgSrc = `/icons/ico_Ivern.jpg`; // 実際のパスに合わせて変更

              let html = `
                <div class="flex">
                  <span>${score}</span>`
              if (synergyTopList.includes(champName)){
                const mate = selectedTop.dataset.value;
                const linkUrl = `/top/${mate}/${role}/${champName}`; 
                html += `<a href="${linkUrl}" target="_blank" style="margin-left:6px;">
                    <img src="${imgMap[mate].icon}" alt="${mate}" class="w-[64px] h-[64px] lg:w-[24px] lg:h-[24px]" style="vertical-align:middle;">
                  </a>`
              }
              if (synergyMidList.includes(champName)){
                const mate = selectedMid.dataset.value;
                const linkUrl = `/mid/${mate}/${role}/${champName}`; 
                html += `<a href="${linkUrl}" target="_blank" style="margin-left:6px;">
                    <img src="${imgMap[mate].icon}" alt="${mate}" class="w-[64px] h-[64px] lg:w-[24px] lg:h-[24px]" style="vertical-align:middle;">
                  </a>`
              }
              if (synergyJgList.includes(champName)){
                const mate = selectedJg.dataset.value;
                const linkUrl = `/jg/${mate}/${role}/${champName}`; 
                html += `<a href="${linkUrl}" target="_blank" style="margin-left:6px;">
                    <img src="${imgMap[mate].icon}" alt="${mate}" class="w-[64px] h-[64px] lg:w-[24px] lg:h-[24px]" style="vertical-align:middle;">
                  </a>`
              }
              if (synergyBotList.includes(champName)){
                const mate = selectedBot.dataset.value;
                const linkUrl = `/bot/${mate}/${role}/${champName}`; 
                html += `<a href="${linkUrl}" target="_blank" style="margin-left:6px;">
                    <img src="${imgMap[mate].icon}" alt="${mate}" class="w-[64px] h-[64px] lg:w-[24px] lg:h-[24px]" style="vertical-align:middle;">
                  </a>`
              }
              if (synergySupList.includes(champName)){
                const mate = selectedSup.dataset.value;
                const linkUrl = `/sup/${mate}/${role}/${champName}`; 
                html += `<a href="${linkUrl}" target="_blank" style="margin-left:6px;">
                    <img src="${imgMap[mate].icon}" alt="${mate}" class="w-[64px] h-[64px] lg:w-[24px] lg:h-[24px]" style="vertical-align:middle;">
                  </a>`
              }

              html += `</div>`;
              scoreCell.innerHTML = html;
            } else {
              scoreCell.textContent = "N/A";
            }
          }
        }

        itemsTop.forEach((item) => {
          item.addEventListener("click", () => {
            // 既に選択されていたアイテムのボーダーを解除
            if (selectedTop) {
              selectedTop.classList.remove("border-blue-500");
              selectedTop.classList.add("border-transparent");
            }
            // 新しい選択を強調
            item.classList.remove("border-transparent");
            item.classList.add("border-blue-500");
            selectedTop = item;

            scoreUpdate();
          });
        });
        itemsJg.forEach((item) => {
          item.addEventListener("click", () => {
            // 既に選択されていたアイテムのボーダーを解除
            if (selectedJg) {
              selectedJg.classList.remove("border-blue-500");
              selectedJg.classList.add("border-transparent");
            }
            // 新しい選択を強調
            item.classList.remove("border-transparent");
            item.classList.add("border-blue-500");
            selectedJg = item;

            scoreUpdate();
          });
        });
        itemsMid.forEach((item) => {
          item.addEventListener("click", () => {
            // 既に選択されていたアイテムのボーダーを解除
            if (selectedMid) {
              selectedMid.classList.remove("border-blue-500");
              selectedMid.classList.add("border-transparent");
            }
            // 新しい選択を強調
            item.classList.remove("border-transparent");
            item.classList.add("border-blue-500");
            selectedMid = item;

            scoreUpdate();
          });
        });
        itemsBot.forEach((item) => {
          item.addEventListener("click", () => {
            // 既に選択されていたアイテムのボーダーを解除
            if (selectedBot) {
              selectedBot.classList.remove("border-blue-500");
              selectedBot.classList.add("border-transparent");
            }
            // 新しい選択を強調
            item.classList.remove("border-transparent");
            item.classList.add("border-blue-500");
            selectedBot = item;

            scoreUpdate();
          });
        });
        itemsSup.forEach((item) => {
          item.addEventListener("click", () => {
            // 既に選択されていたアイテムのボーダーを解除
            if (selectedSup) {
              selectedSup.classList.remove("border-blue-500");
              selectedSup.classList.add("border-transparent");
            }
            // 新しい選択を強調
            item.classList.remove("border-transparent");
            item.classList.add("border-blue-500");
            selectedSup = item;

            scoreUpdate();
          });
        });

        // テーブルのソート機能
        const table = document.getElementById("champion-table");
        const tbody = table.querySelector("tbody");
        const headers = table.querySelectorAll("th");

        headers.forEach((header, index) => {
          header.addEventListener("click", () => {
            const rows = Array.from(tbody.querySelectorAll("tr"));
            const isDesc = !header.classList.contains("sort-desc"); // 次が昇順か降順か
            const direction = isDesc ? -1 : 1;

            // 他の列のソート状態リセット
            headers.forEach(h => h.classList.remove("sort-asc", "sort-desc"));
            header.classList.add(isDesc ? "sort-desc" : "sort-asc");

            const getCellValue = (row, idx) =>
              row.children[idx].textContent.trim().replace("%", "");

            rows.sort((a, b) => {
              const aVal = getCellValue(a, index);
              const bVal = getCellValue(b, index);

              const aNum = parseFloat(aVal);
              const bNum = parseFloat(bVal);

              if (!isNaN(aNum) && !isNaN(bNum)) {
                return (aNum - bNum) * direction;
              } else {
                return aVal.localeCompare(bVal, "ja") * direction;
              }
            });

            // 並べ替えた結果を反映
            tbody.innerHTML = "";
            rows.forEach(row => tbody.appendChild(row));
          });
        });
        // チャンプ名の昇順
        headers[0].classList.add("sort-asc");

        // ピックプールによるフィルタ
        const pickPool = JSON.parse(localStorage.getItem("pickPool") || "{}");

        if (pickPool.length > 0) {
          const table = document.getElementById("champion-table");
          const rows = Array.from(table.querySelectorAll("tbody tr"));

          rows.forEach(row => {
            const champName = row.cells[0].textContent.trim();
            if (!pickPool.includes(champName)) {
              row.style.display = "none"; // フィルタ：ピックプール外を非表示
            }
          });
        }

        // ピックプールによるフィルタ
        document.getElementById("pick-pool-filter").addEventListener("click", () => {
          document.querySelectorAll("#champion-table tbody tr").forEach(row => {
            const champName = row.cells[0].textContent.trim();
            if (!pickPool.includes(champName)) {
              row.style.display = "none"; // フィルタ：ピックプール外を非表示
            }
          });
        });
        // ピックプールによるフィルタ解除
        document.getElementById("reset-filter").addEventListener("click", () => {
          document.querySelectorAll("#champion-table tbody tr").forEach(row => {
            row.style.display = "";
          });
        });
      });
    </script>
  </head>
  <body class="flex-col max-lg:text-5xl gap-4 p-4 bg-blue-100">
    <div class="block"> 
      <CollapsibleSection title="自チームチャンピオン一覧">
        {role !== 'top' &&
          <h2>Top</h2>
          <ul id="champion-list" class="flex flex-wrap justify-center items-center gap-x-[5px] gap-y-[5px] h-[20%] overflow-scroll bg-gray-100 p-4 text-base border rounded h-[20vh]">
            {synergyChampions['top'].slice() // 元配列を壊さないようコピー
                      .sort((a, b) => a.localeCompare(b, "ja")) // 日本語に対応した昇順ソート
                      .map(c => {
                        if (!(c in imgMap)) {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-top flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                {c}
                              </button>
                            </li> 
                          );
                        } else {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-top flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                <img 
                                  src={imgMap[c]['icon']}
                                  alt={c}
                                  class="w-[100px] h-[100px] lg:w-[32px] lg:h-[32px] object-contain"
                                />
                              </button>
                            </li>
                        );}
            })}
          </ul>
        }
        {role !== 'jg' &&
          <h2>Jg</h2>
          <ul id="champion-list" class="flex flex-wrap justify-center items-center gap-x-[5px] gap-y-[5px] h-[20%] overflow-scroll bg-gray-100 p-4 text-base border rounded h-[20vh]">
            {synergyChampions['jg'].slice() // 元配列を壊さないようコピー
                      .sort((a, b) => a.localeCompare(b, "ja")) // 日本語に対応した昇順ソート
                      .map(c => {
                        if (!(c in imgMap)) {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-jg flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                {c}
                              </button>
                            </li> 
                          );
                        } else {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-jg flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                <img 
                                  src={imgMap[c]['icon']}
                                  alt={c}
                                  class="w-[100px] h-[100px] lg:w-[32px] lg:h-[32px] object-contain"
                                />
                              </button>
                            </li>
                        );}
            })}
          </ul>
        }
        {role !== 'mid' &&
          <h2>Mid</h2>
          <ul id="champion-list" class="flex flex-wrap justify-center items-center gap-x-[5px] gap-y-[5px] h-[20%] overflow-scroll bg-gray-100 p-4 text-base border rounded h-[20vh]">
            {synergyChampions['mid'].slice() // 元配列を壊さないようコピー
                      .sort((a, b) => a.localeCompare(b, "ja")) // 日本語に対応した昇順ソート
                      .map(c => {
                        if (!(c in imgMap)) {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-mid flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                {c}
                              </button>
                            </li> 
                          );
                        } else {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-mid flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                <img 
                                  src={imgMap[c]['icon']}
                                  alt={c}
                                  class="w-[100px] h-[100px] lg:w-[32px] lg:h-[32px] object-contain"
                                />
                              </button>
                              
                            </li>
                        );}
            })}
          </ul>
        }
        {role !== 'bot' &&
          <h2>Bot</h2>
          <ul id="champion-list" class="flex flex-wrap justify-center items-center gap-x-[5px] gap-y-[5px] h-[20%] overflow-scroll bg-gray-100 p-4 text-base border rounded h-[20vh]">
            {synergyChampions['bot'].slice() // 元配列を壊さないようコピー
                      .sort((a, b) => a.localeCompare(b, "ja")) // 日本語に対応した昇順ソート
                      .map(c => {
                        if (!(c in imgMap)) {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-bot flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                {c}
                              </button>
                            </li> 
                          );
                        } else {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-bot flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                <img 
                                  src={imgMap[c]['icon']}
                                  alt={c}
                                  class="w-[100px] h-[100px] lg:w-[32px] lg:h-[32px] object-contain"
                                />
                              </button>
                              
                            </li>
                        );}
            })}
          </ul>
        }
        {role !== 'sup' &&
          <h2>Sup</h2>
          <ul id="champion-list" class="flex flex-wrap justify-center items-center gap-x-[5px] gap-y-[5px] h-[20%] overflow-scroll bg-gray-100 p-4 text-base border rounded h-[20vh]">
            {synergyChampions['sup'].slice() // 元配列を壊さないようコピー
                      .sort((a, b) => a.localeCompare(b, "ja")) // 日本語に対応した昇順ソート
                      .map(c => {
                        if (!(c in imgMap)) {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-sup flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                {c}
                              </button>
                            </li> 
                          );
                        } else {
                          return (
                            <li>
                              <button
                                type="button"
                                data-value={c}
                                class="champ-item-sup flex flex-col items-center border-13 lg:border-4 border-transparent rounded-2xl hover:border-blue-400 transition transform hover:scale-105 focus:outline-none"
                              >
                                <img 
                                  src={imgMap[c]['icon']}
                                  alt={c}
                                  class="w-[100px] h-[100px] lg:w-[32px] lg:h-[32px] object-contain"
                                />
                              </button>
                              
                            </li>
                        );}
            })}
          </ul>
        }
      </CollapsibleSection>
    </div>
    <div class="flex-col lg:flex-row flex">
      <!-- 左側：チャンピオン一覧 -->
      <div class="w-full h-[30vh] lg:w-1/2 lg:h-[100vh] overflow-y-scroll bg-gray-50 border rounded p-4 m-4">
        <div class="flex items-center">
          <img src={
            role==="top" ? "https://nitamago.github.io/lol-matchup-dictionary/icons/top_icon.PNG":
            role==="mid" ? "https://nitamago.github.io/lol-matchup-dictionary/icons/mid_icon.PNG":
            role==="jg" ? "https://nitamago.github.io/lol-matchup-dictionary/icons/jg_icon.PNG":
            role==="bot" ? "https://nitamago.github.io/lol-matchup-dictionary/icons/bot_icon.PNG":
            "https://nitamago.github.io/lol-matchup-dictionary/icons/sup_icon.PNG"
            } alt={role} class="relative w-[100px] lg:w-[50px] rounded-[50%] ">
          <span class="ml-[10px]">{role}</span>
          <h1 class="font-bold ml-30 text-center text-4xl lg:text-lg">自分チャンピオン一覧</h1>
        </div>
        <button id="pick-pool-filter" class="mt-2 border rounded px-2 py-1 bg-gray-200 hover:bg-gray-300">
          ピックプールフィルタ
        </button>
        <button id="reset-filter" class="mt-2 border rounded px-2 py-1 bg-gray-200 hover:bg-gray-300">
          ピックプールフィルタ解除
        </button>
        <table id="champion-table" class="w-full border-collapse text-sm">
          <thead class="bg-gray-200 sticky top-0">
            <tr>
              <th class="border p-2 text-left cursor-pointer text-4xl lg:text-base">チャンピオン</th>
              <th class="border p-2 text-center cursor-pointer text-4xl lg:text-base" title="LoLalyticsの勝率">勝率</th>
              <th class="border p-2 text-center cursor-pointer text-4xl lg:text-base" title="不利対面時の最低勝率を示します。すくなくともこの勝率は保証されていると解釈できます。">最悪勝率</th>
              <th class="border p-2 text-center cursor-pointer text-4xl lg:text-base" title="自チームチャンプとのsynergy delta2の総和です。">シナジー</th>
            </tr>
          </thead>
          <tbody id="champion-list">
            {champions
              .slice()
              .filter((a)=>data[a]['game_count']>=14000)
              .sort((a, b) => a.localeCompare(b, "ja"))
              .map((c) => {
                const info = data[c] || {}; // ← 各チャンピオンの追加データをここで参照
                return (
                  <tr class="hover:bg-blue-50 transition">
                    <td class="border p-2 flex items-center gap-2">
                      <img
                        src={imgMap[c]?.icon || '/default-icon.png'}
                        alt={c}
                        class="w-[64px] h-[64px] lg:w-6 lg:h-6 object-contain rounded-full"
                      />
                      <a
                        href="#"
                        data-champ={c}
                        class="text-blue-600 hover:underline text-4xl lg:text-base"
                      >
                        {c}
                      </a>
                    </td>
                    <td class="border p-2 text-center text-4xl lg:text-base">
                      {(rawData[c]?.win_rate) ? rawData[c].win_rate.toFixed(1)+'%' : '???'}
                    </td>
                    <td class="border p-2 text-center text-4xl lg:text-base">
                      {(data[c]?.loses?.length > 0) ? (() => {
                            const values = data[c].loses
                              .map((x) => {return {delta2: parseFloat(x.delta2.replace('*','')), anotate: x.delta2.includes('*')}})
                              .filter((v) => {return !isNaN(v.delta2)}) // NaNを除外
                              .filter((v) => {return !v.anotate}); // 少数データを除外
                            if (values.length === 0) return '???';
                            const minItem = values.reduce((min, item) =>
                              item.delta2 < min.delta2 ? item : min
                            );

                            if (minItem.anotate) {
                              return (50+minItem.delta2).toFixed(1)+'%*';
                            }
                            else {
                              return (50+minItem.delta2).toFixed(1)+'%';
                            }
                          })
                        : '???'}
                      {/* {info.winRate ? `${info.winRate.toFixed(1)}%` : '-'} */}
                    </td>
                    <td id={"synergy-"+c} class="border p-2 text-center text-4xl lg:text-base">
                      0
                    </td>
                  </tr>
                );
              })}
          </tbody>
        </table>
      </div>
      
      <!-- 右側：詳細表示 -->
      <div id="champion-detail" class="lg:w-1/2 sticky top-0 m-4">
        <p class="block lg:hidden font-semibold text-blue-700">
          上の一覧から対面チャンピオン名をクリックしてください
        </p>
        <p class="hidden lg:block font-semibold text-blue-700">
          左の一覧から対面チャンピオン名をクリックしてください
        </p>
      </div>
    </div>

    <!-- 埋め込みデータ -->
    <div id="role" class="hidden">
      {role}
    </div>
    <!-- 埋め込みデータ -->
    <div id="role-data" class="hidden">
      {JSON.stringify(data)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="role-data-key" class="hidden">
      {JSON.stringify(champions)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="role-en-map" class="hidden">
      {JSON.stringify(enMap)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="img-map" class="hidden">
      {JSON.stringify(imgMap)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="rune-build-map" class="hidden">
      {JSON.stringify(runeBuildMap)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="synergy-map" class="hidden">
      {JSON.stringify(synergeyMaps)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="synergy-champions" class="hidden">
      {JSON.stringify(synergyChampions)}
    </div>
    <!-- 埋め込みデータ -->
    <div id="raw-data" class="hidden">
      {JSON.stringify(rawData)}
    </div>
  </body>
</html>