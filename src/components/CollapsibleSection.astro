---
const { title } = Astro.props;
---

<div class="border rounded-lg mb-2">
  <button 
    class="w-full flex justify-between items-center p-3 bg-gray-50 hover:bg-gray-200"
    onclick="this.nextElementSibling.classList.toggle('hidden')"
  >
    <span class="font-semibold">{title}</span>
    <span>▼</span>
  </button>
  <div class="p-3 hidden">
    <div class="lg:grid lg:grid-cols-2 lg:gap-1 lg:h-[80vh]">
      <slot />
    </div>
  </div>
</div>
